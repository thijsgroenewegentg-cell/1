OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=jarvis
# fallback models in order if jarvis not found
FALLBACK_MODELS=qwen2.5:7b,llama3.1:8b,mistral-nemo,gemma2:9b
EMBEDDING_MODEL=nomic-embed-text
# safe fallback if embedding model missing -> hash embedding

# Voice
VOICE_ENABLED=false
WAKE_WORD=jarvis
TTS_ENGINE=edge
# edge (Microsoft, sounds like JARVIS) or pyttsx3 (offline robotic) or elevenlabs
TTS_VOICE=en-GB-RyanNeural
# For Jarvis-like: en-GB-RyanNeural, en-US-GuyNeural, en-GB-SoniaNeural for FRIDAY
STT_ENGINE=faster-whisper
# faster-whisper (offline), google, whisper-api

# Memory & Learning
MEMORY_FILE=data/long_term_memory.json
CONVERSATION_FILE=data/conversations.json
WORKSPACE_DIR=./workspace
LEARNING_ENABLED=true
AUTO_MEMORY=true
REFLECTION_INTERVAL=10
VECTOR_STORE=data/vectors.json
USER_PROFILE=data/user_profile.json

# Self-Evolution - JARVIS makes himself better
EVOLUTION_ENABLED=true
SELF_EDIT_ENABLED=true
# true = JARVIS can edit own code autonomously with backup+compile check+auto-rollback
# false = proposes edits, saves to data/evolution/pending_edits.json, requires approval
# Safety: every edit backed up to data/backups/self_edit/, compile checked, rollback on fail
EVOLUTION_INTERVAL=50

# Always-On Wake Word
ALWAYS_ON_ENABLED=false
# false = manual wake (press button or say once), true = 24/7 listening in background like real JARVIS
WAKEWORD_ENGINE=auto
# auto tries openwakeword (best) -> whisper tiny -> google
WAKEWORD_SENSITIVITY=0.5

# Proactive Agent
PROACTIVE_ENABLED=true
# true = morning briefing 8:30, evening summary 18:00, git watcher, routine suggestions, desktop notifications
MORNING_BRIEF_HOUR=8
MORNING_BRIEF_MINUTE=30
EVENING_BRIEF_HOUR=18

# Multi-Agent Team
TEAM_ENABLED=true
# true = Planner, Researcher, Coder, Reviewer collaborate on complex tasks

# Security - limit what shell commands can do
ALLOW_SHELL=true
SAFE_MODE=false

# Web
WEB_HOST=0.0.0.0
WEB_PORT=8000
# UI_MODE: minimal (new) or classic
UI_MODE=minimal

# User
USER_NAME=Sir
JARVIS_NAME=JARVIS
