OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=jarvis
# fallback models in order if jarvis not found
FALLBACK_MODELS=qwen2.5:7b,llama3.1:8b,mistral-nemo,gemma2:9b

# Voice
VOICE_ENABLED=false
WAKE_WORD=jarvis
TTS_ENGINE=edge
# edge (Microsoft, sounds like JARVIS) or pyttsx3 (offline robotic) or elevenlabs
TTS_VOICE=en-GB-RyanNeural
# For Jarvis-like: en-GB-RyanNeural, en-US-GuyNeural, en-GB-SoniaNeural for FRIDAY
STT_ENGINE=faster-whisper
# faster-whisper (offline), google, whisper-api

# Memory
MEMORY_FILE=data/long_term_memory.json
CONVERSATION_FILE=data/conversations.json
WORKSPACE_DIR=./workspace

# Security - limit what shell commands can do
ALLOW_SHELL=true
SAFE_MODE=false

# Web
WEB_HOST=0.0.0.0
WEB_PORT=8000

# User
USER_NAME=Sir
JARVIS_NAME=JARVIS
