OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=jarvis
FALLBACK_MODELS=qwen2.5:7b,llama3.1:8b,mistral-nemo,gemma2:9b
EMBEDDING_MODEL=nomic-embed-text
# fallback hash embedding if model missing - still free

# Voice - 100% FREE, MUST BE PIPER - NO API KEYS, NO PAID, 100% OFFLINE
VOICE_ENABLED=false
WAKE_WORD=jarvis
TTS_ENGINE=piper
# MUST BE PIPER: BEST FREE OFFLINE, 100% local ONNX, high quality British, Manina premium style, fully free
# piper = 100% free offline, local ONNX, high quality British, no internet, no keys - REQUIRED
# Install: pip install piper-tts --break-system-packages && python -m piper.download_voices en_GB-alan-medium --data-dir data/piper_models
# Other FREE options (but piper is MUST):
# edge = free online with premium FX (alternative), xtts = free local cloning, pyttsx3 = free offline fallback
TTS_VOICE=en_GB-alan-medium
# Piper voices (all free British): en_GB-alan-medium (classic JARVIS), en_GB-jenny_dioco-medium (FRIDAY), en_GB-southern_english_male-medium (deep commanding)
PREMIUM_VOICE_STYLE=manina_premium
# manina_premium = deep British cinematic, FREE, uses piper en_GB-alan-medium + bass+reverb+chorus
STT_ENGINE=faster-whisper

# Voice Setup - 100% FREE, MUST BE PIPER:
# 1. Install: pip install piper-tts --break-system-packages
# 2. Download voice: python -m piper.download_voices en_GB-alan-medium --data-dir data/piper_models
#    Or: pip install piper-tts && python3 -c "import piper; print('Downloading...')" && wget https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_GB/alan/medium/en_GB-alan-medium.onnx -P data/piper_models/ && wget https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_GB/alan/medium/en_GB-alan-medium.onnx.json -P data/piper_models/
# 3. .env: TTS_ENGINE=piper, TTS_VOICE=en_GB-alan-medium (already set)
# That's it - fully free offline premium voice, Manina style

# Memory & Learning - 100% free local
MEMORY_FILE=data/long_term_memory.json
CONVERSATION_FILE=data/conversations.json
WORKSPACE_DIR=./workspace
LEARNING_ENABLED=true
AUTO_MEMORY=true
REFLECTION_INTERVAL=10
VECTOR_STORE=data/vectors.json
USER_PROFILE=data/user_profile.json

# Self-Evolution - FREE
EVOLUTION_ENABLED=true
SELF_EDIT_ENABLED=true
EVOLUTION_INTERVAL=50

# Always-On Wake Word - FREE
ALWAYS_ON_ENABLED=false
WAKEWORD_ENGINE=auto
# auto tries openwakeword (free local ONNX) -> whisper tiny (free) -> google (free but online)
WAKEWORD_SENSITIVITY=0.5

# Proactive Agent - FREE
PROACTIVE_ENABLED=true
MORNING_BRIEF_HOUR=8
MORNING_BRIEF_MINUTE=30
EVENING_BRIEF_HOUR=18

# Multi-Agent Team - FREE
TEAM_ENABLED=true

# Security
ALLOW_SHELL=true
SAFE_MODE=false

# Web - FREE
WEB_HOST=0.0.0.0
WEB_PORT=8000
UI_MODE=minimal

# User
USER_NAME=Sir
JARVIS_NAME=JARVIS

# OPTIONAL PAID KEYS - NOT NEEDED FOR FULLY FREE SETUP
# Only fill if you WANT paid quality, all features work 100% free without these:
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# OPENAI_API_KEY=
