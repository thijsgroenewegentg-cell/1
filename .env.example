OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=jarvis
FALLBACK_MODELS=qwen2.5:7b,llama3.1:8b,mistral-nemo,gemma2:9b
EMBEDDING_MODEL=nomic-embed-text
# fallback hash embedding if model missing - still free

# Voice - 100% FREE, NO API KEYS NEEDED
VOICE_ENABLED=false
WAKE_WORD=jarvis
TTS_ENGINE=edge
# FREE engines (no API key, fully free):
# edge = FREE, Microsoft free online, with premium FX (bass+reverb+chorus) = Manina style, default
# piper = BEST FREE OFFLINE, 100% local ONNX, high quality British, needs: pip install piper-tts
# xtts = FREE local voice cloning, clone any voice from sample, needs: pip install TTS (2GB model)
# pyttsx3 = FREE offline robotic fallback, always works
# Optional PAID (NOT needed, only if you want):
# elevenlabs = PAID, needs ELEVENLABS_API_KEY
# openai = PAID, needs OPENAI_API_KEY
TTS_VOICE=en-GB-RyanNeural
PREMIUM_VOICE_STYLE=manina_premium
# manina_premium = deep British cinematic, FREE
# jarvis_classic, jarvis_deep, friday, manina_blender - all FREE
STT_ENGINE=faster-whisper
# faster-whisper = FREE offline STT, best

# FREE Voice Setup (no keys):
# 1. Default already works: TTS_ENGINE=edge + PREMIUM_VOICE_STYLE=manina_premium
# 2. Best offline: pip install piper-tts && python -m piper.download_voices en_GB-alan-medium
#    Then: TTS_ENGINE=piper
# 3. Clone voice: pip install TTS, place WAV in data/voices/manina_premium.wav, TTS_ENGINE=xtts

# Memory & Learning - 100% free local
MEMORY_FILE=data/long_term_memory.json
CONVERSATION_FILE=data/conversations.json
WORKSPACE_DIR=./workspace
LEARNING_ENABLED=true
AUTO_MEMORY=true
REFLECTION_INTERVAL=10
VECTOR_STORE=data/vectors.json
USER_PROFILE=data/user_profile.json

# Self-Evolution - FREE
EVOLUTION_ENABLED=true
SELF_EDIT_ENABLED=true
EVOLUTION_INTERVAL=50

# Always-On Wake Word - FREE
ALWAYS_ON_ENABLED=false
WAKEWORD_ENGINE=auto
# auto tries openwakeword (free local ONNX) -> whisper tiny (free) -> google (free but online)
WAKEWORD_SENSITIVITY=0.5

# Proactive Agent - FREE
PROACTIVE_ENABLED=true
MORNING_BRIEF_HOUR=8
MORNING_BRIEF_MINUTE=30
EVENING_BRIEF_HOUR=18

# Multi-Agent Team - FREE
TEAM_ENABLED=true

# Security
ALLOW_SHELL=true
SAFE_MODE=false

# Web - FREE
WEB_HOST=0.0.0.0
WEB_PORT=8000
UI_MODE=minimal

# User
USER_NAME=Sir
JARVIS_NAME=JARVIS

# OPTIONAL PAID KEYS - NOT NEEDED FOR FULLY FREE SETUP
# Only fill if you WANT paid quality, all features work 100% free without these:
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# OPENAI_API_KEY=
