diff --git a/src/llm/ollama.test.ts b/src/llm/ollama.test.ts
index 74d0540..8369f24 100644
--- a/src/llm/ollama.test.ts
+++ b/src/llm/ollama.test.ts
@@ -39,6 +39,75 @@ type OllamaWireMessage = {
   tool_call_id?: string;
 };
 
+type OllamaWireBody = {
+  messages: OllamaWireMessage[];
+  options?: Record<string, unknown>;
+};
+
+describe('OllamaProvider context window', () => {
+  afterEach(() => {
+    globalThis.fetch = originalFetch;
+  });
+
+  /**
+   * Ollama loads 4096 tokens by default and answers anyway when the prompt is
+   * longer — it drops the FRONT, which is where jarvis keeps its system prompt
+   * (role instructions + ~4.3k tokens of tool schemas). Omitting num_ctx is
+   * therefore not a missing nicety: it silently deletes the instructions and
+   * the model looks broken instead of truncated.
+   */
+  it('asks for a window large enough for the prompt it budgets for (chat)', async () => {
+    const body = await captureChatBody([{ role: 'user', content: 'hi' }]) as OllamaWireBody;
+    expect(body.options?.num_ctx).toBe(32000);
+  });
+
+  it('asks for the same window when streaming', async () => {
+    let captured: string | undefined;
+    globalThis.fetch = (async (_url: string, init: RequestInit) => {
+      captured = init.body as string;
+      return new Response(
+        `${JSON.stringify({
+          model: 'qwen2.5:3b',
+          created_at: '',
+          message: { role: 'assistant', content: 'ok' },
+          done: true,
+        })}\n`,
+        { status: 200 },
+      );
+    }) as unknown as typeof fetch;
+
+    // Drain the stream so the request is guaranteed to have been issued.
+    for await (const _event of new OllamaProvider().stream([{ role: 'user', content: 'hi' }])) {
+      // no-op
+    }
+
+    expect(captured).toBeDefined();
+    const body = JSON.parse(captured!) as OllamaWireBody;
+    expect(body.options?.num_ctx).toBe(32000);
+  });
+
+  it('leaves temperature and max_tokens riding alongside num_ctx, not instead of it', async () => {
+    let captured: string | undefined;
+    globalThis.fetch = (async (_url: string, init: RequestInit) => {
+      captured = init.body as string;
+      return new Response(JSON.stringify({
+        model: 'qwen2.5:3b',
+        created_at: '',
+        message: { role: 'assistant', content: 'ok' },
+        done: true,
+      }), { status: 200 });
+    }) as unknown as typeof fetch;
+
+    await new OllamaProvider().chat([{ role: 'user', content: 'hi' }], {
+      temperature: 0.3,
+      max_tokens: 64,
+    });
+
+    const body = JSON.parse(captured!) as OllamaWireBody;
+    expect(body.options).toMatchObject({ num_ctx: 32000, temperature: 0.3, num_predict: 64 });
+  });
+});
+
