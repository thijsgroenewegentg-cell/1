OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=jarvis
FALLBACK_MODELS=qwen2.5:7b,llama3.1:8b,mistral-nemo,gemma2:9b
EMBEDDING_MODEL=nomic-embed-text

# Voice - PIPER FREE by default, YOUR ElevenLabs CwhRBWXzGAHq8TQ4Fs17 for premium JARVIS voice
VOICE_ENABLED=false
WAKE_WORD=jarvis
TTS_ENGINE=piper
# To use YOUR premium ElevenLabs voice CwhRBWXzGAHq8TQ4Fs17:
# 1. Get API key from https://elevenlabs.io/app/settings/api-keys
# 2. Set: TTS_ENGINE=elevenlabs, ELEVENLABS_API_KEY=your_key, ELEVENLABS_VOICE_ID=CwhRBWXzGAHq8TQ4Fs17
# 3. Your voice ID CwhRBWXzGAHq8TQ4Fs17 will be JARVIS voice - deep British cinematic
# FREE options (no keys): piper (BEST FREE OFFLINE British), edge (free online with FX), xtts (free clone), pyttsx3
TTS_VOICE=en_GB-alan-medium
ELEVENLABS_VOICE_ID=CwhRBWXzGAHq8TQ4Fs17
# Your ElevenLabs voice - JARVIS premium British cinematic - YOUR CODE
ELEVENLABS_API_KEY=
# Set your ElevenLabs API key to use CwhRBWXzGAHq8TQ4Fs17 as JARVIS voice
PREMIUM_VOICE_STYLE=manina_premium
STT_ENGINE=faster-whisper

# Voice Setup:
# FREE (default, no key): TTS_ENGINE=piper + pip install piper-tts + python -m piper.download_voices en_GB-alan-medium --data-dir data/piper_models
# PREMIUM (your voice): TTS_ENGINE=elevenlabs + ELEVENLABS_API_KEY + ELEVENLABS_VOICE_ID=CwhRBWXzGAHq8TQ4Fs17

# Memory & Learning - 100% free local
MEMORY_FILE=data/long_term_memory.json
CONVERSATION_FILE=data/conversations.json
WORKSPACE_DIR=./workspace
LEARNING_ENABLED=true
AUTO_MEMORY=true
REFLECTION_INTERVAL=10
VECTOR_STORE=data/vectors.json
USER_PROFILE=data/user_profile.json

# Self-Evolution - FREE
EVOLUTION_ENABLED=true
SELF_EDIT_ENABLED=true
EVOLUTION_INTERVAL=50

# Always-On Wake Word - FREE
ALWAYS_ON_ENABLED=false
WAKEWORD_ENGINE=auto
WAKEWORD_SENSITIVITY=0.5

# Proactive Agent - FREE
PROACTIVE_ENABLED=true
MORNING_BRIEF_HOUR=8
MORNING_BRIEF_MINUTE=30
EVENING_BRIEF_HOUR=18

# Multi-Agent Team - FREE
TEAM_ENABLED=true

# Productivity Hub - FREE local
CALENDAR_DIRS=workspace/calendar,data/calendar
EMAIL_IMAP_HOST=
EMAIL_SMTP_HOST=

# Media & Entertainment - FREE local
MUSIC_DIRS=workspace/music,~/Music
PIPER_MODELS_DIR=data/piper_models

# Security
ALLOW_SHELL=true
SAFE_MODE=false

# Web - FREE
WEB_HOST=0.0.0.0
WEB_PORT=8000
UI_MODE=minimal

# User
USER_NAME=Sir
JARVIS_NAME=JARVIS

# OPTIONAL PAID - Only for ElevenLabs premium voice CwhRBWXzGAHq8TQ4Fs17, leave empty for fully free Piper
# ELEVENLABS_API_KEY=sk-...
# OPENAI_API_KEY=
